{
  "name": "stockpilot",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "db:setup": "prisma db push && prisma db execute --file prisma/checks.sql --schema prisma/schema.prisma",
    "seed": "tsx prisma/seed.ts",
    "test:setup": "tsx scripts/test-setup.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "integrity": "tsx scripts/integrity.ts"
  },
  "dependencies": {
    "@prisma/client": "5.22.0",
    "bcryptjs": "2.4.3",
    "jose": "5.9.6",
    "next": "14.2.18",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "2.4.6",
    "@types/node": "20.17.6",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "prisma": "5.22.0",
    "tsx": "4.19.2",
    "typescript": "5.6.3",
    "vitest": "2.1.5"
  }
}
